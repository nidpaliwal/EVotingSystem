<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site3Party.master.cs" Inherits="EVotingSystem.Site3Party" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>E-Voting System — Party</title>
    <link href="~/Styles/site.css" rel="stylesheet" type="text/css" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="portal-party">
    <form id="form1" runat="server">
        <header class="site-header">
            <div class="header-inner">
                <div class="brand">E-Voting System<small>Secure &amp; Transparent Elections</small></div>
                <span class="portal-chip">Party Portal</span>
            </div>
            <nav class="site-nav" aria-label="Main navigation">
                <div class="nav-inner">
                    <asp:HyperLink ID="HyperLink1" runat="server" CssClass="nav-link" NavigateUrl="~/PartyDashboard.aspx">Dashboard</asp:HyperLink>
                    <asp:HyperLink ID="HyperLink2" runat="server" CssClass="nav-link" NavigateUrl="~/MyProfile.aspx">My Profile</asp:HyperLink>
                    <asp:HyperLink ID="HyperLink3" runat="server" CssClass="nav-link" NavigateUrl="~/PartyStatus.aspx">Status</asp:HyperLink>
                    <asp:HyperLink ID="HyperLink6" runat="server" CssClass="nav-link" NavigateUrl="~/PartyElectionHistory.aspx">Results</asp:HyperLink>
                    <asp:HyperLink ID="HyperLink5" runat="server" CssClass="nav-link" NavigateUrl="~/Logout.aspx">Logout</asp:HyperLink>
                </div>
            </nav>
        </header>
        <main class="container">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </main>
        <footer class="site-footer">
            E-Voting System &copy; 2026 &middot; Party Portal
        </footer>
    </form>
</body>
</html>
