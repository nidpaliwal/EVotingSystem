<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site4Voter.master.cs" Inherits="EVotingSystem.Site4Voter" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>E-Voting System — Voter</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23123a54'/%3E%3Cpath d='M8 17l5 5 11-12' stroke='%23fff' stroke-width='3.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <link href="~/Styles/site.css" rel="stylesheet" type="text/css" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="portal-voter">
    <form id="form1" runat="server">
        <a class="skip-link" href="#main">Skip to main content</a>
        <header class="site-header">
            <div class="header-inner">
                <div class="brand">E-Voting System<small>Secure &amp; Transparent Elections</small></div>
                <span class="portal-chip">Voter Portal</span>
            </div>
            <nav class="site-nav" aria-label="Main navigation">
                <div class="nav-inner">
                    <asp:HyperLink ID="HyperLink1" runat="server" CssClass="nav-link" NavigateUrl="~/VoterDashboard.aspx">Dashboard</asp:HyperLink>
                    <asp:HyperLink ID="HyperLink2" runat="server" CssClass="nav-link" NavigateUrl="~/PartyListVoter.aspx">Party List</asp:HyperLink>
                    <asp:HyperLink ID="HyperLink3" runat="server" CssClass="nav-link" NavigateUrl="~/VoterVote.aspx">Vote</asp:HyperLink>
                    <asp:HyperLink ID="HyperLink4" runat="server" CssClass="nav-link" NavigateUrl="~/VoterStatus.aspx">My Status</asp:HyperLink>
                    <asp:HyperLink ID="HyperLink7" runat="server" CssClass="nav-link" NavigateUrl="~/VoterElectionHistory.aspx">Results</asp:HyperLink>
                    <asp:HyperLink ID="HyperLink6" runat="server" CssClass="nav-link" NavigateUrl="~/Logout.aspx">Logout</asp:HyperLink>
                </div>
            </nav>
        </header>
        <main class="container">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </main>
        <footer class="site-footer">
            E-Voting System &copy; 2026 &middot; Voter Portal
        </footer>
    </form>
</body>
</html>
